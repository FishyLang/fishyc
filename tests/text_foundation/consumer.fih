fn analyze(text:String)->i32 {
    let mut words:u64=0;let mut spaces:u64=0;let mut lines:u64=0;let mut in_word=false;let mut i:u64=0;
    while i<text.len() {
        let byte=text.byte_at(i).unwrap();let space=is_ascii_whitespace(byte);
        if space {spaces=spaces+1;} else {if !in_word {words=words+1;}}
        in_word=!space;if byte==10 {lines=lines+1;}i=i+1;
    }
    if !text.is_empty() && text.byte_at(text.len()-1).unwrap()!=10 {lines=lines+1;}
    let clean=text.trim_ascii();
    let newline=clean.find(String.from_c_string("\n")).unwrap();
    let first_line=clean.try_slice(0,newline).unwrap().trim_ascii();
    let suffix=String.from_c_string("fast");
    let prefix_ok=clean.starts_with(String.from_c_string("Fishy"));
    let suffix_ok=clean.ends_with(suffix);
    printf("bytes=%lu lines=%lu words=%lu whitespace=%lu\n",text.len(),lines,words,spaces);
    printf("trimmed=%lu newline=%lu prefix=%ld suffix=%ld first_line=%lu\n",
        clean.len(),newline,prefix_ok,suffix_ok,first_line.len());
    if !first_line.equals(String.from_c_string("Fishy byte tools")) {return 1;}
    return 0;
}
fn main()->i32 {return analyze(String.from_c_string(" \tFishy byte tools\r\nfish swim fast\n \t"));}
