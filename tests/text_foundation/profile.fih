extern fn prototype_allocations()->u64;
extern fn prototype_live()->u64;
extern fn prototype_live_bytes()->u64;
fn row(label:string, size:u64, allocations:u64, live:u64, bytes:u64)->void {
    printf("text %lu %s %lu %lu %lu\n",size,label,prototype_allocations()-allocations,
        prototype_live()-live,prototype_live_bytes()-bytes);
}
fn exercise(size:u64)->void {
    let mut b=ByteBuffer.new();let mut i:u64=0;while i<size {b.push(97);i=i+1;}
    b.set(size-1,98);let text=b.snapshot();
    let prefix=text.try_slice(0,size-1).unwrap();let suffix=text.try_slice(1,size).unwrap();
    let single=String.from_c_string("z");let partial=String.from_c_string("aaaaac");
    b.set(0,32);b.set(size-1,32);let dirty=b.snapshot();
    let mut spaces=ByteBuffer.new();i=0;while i<size {spaces.push(32);i=i+1;}
    let blank=spaces.snapshot();
    let mut allocations=prototype_allocations();let live=prototype_live();let bytes=prototype_live_bytes();
    if !text.starts_with(prefix) || !text.ends_with(suffix) {panic("comparison profile values");}
    row("prefix_suffix",size,allocations,live,bytes);
    if prototype_allocations()!=allocations {panic("comparison allocated");}
    
    let unchanged=text.trim_ascii();if unchanged==text || !unchanged.equals(text) {panic("trim clone contract");}
    row("trim_unchanged",size,allocations,live,bytes);
    if prototype_allocations()!=allocations+1 {panic("unchanged trim must allocate one logical String wrapper");}
    allocations=prototype_allocations();
    { let found=text.find(single);
      row("find_absent",size,allocations,live,bytes);
      if found.is_some() || prototype_allocations()!=allocations+1 {panic("find allocation");} }
    allocations=prototype_allocations();
    { let found=text.find(partial);row("find_partial",size,allocations,live,bytes);
      if found.is_some() || prototype_allocations()!=allocations+1 {panic("partial search allocation");} }
    allocations=prototype_allocations();
    { let found=text.find(text);row("find_full",size,allocations,live,bytes);
      if found.unwrap()!=0 || prototype_allocations()!=allocations+1 {panic("full search allocation");} }
    allocations=prototype_allocations();
    { let sliced=text.try_slice(1,size).unwrap();row("slice",size,allocations,live,bytes);
      if sliced.len()!=size-1 {panic("slice profile length");} }
    allocations=prototype_allocations();
    { let trimmed=dirty.trim_ascii();row("trim_partial",size,allocations,live,bytes);
      if trimmed.len()!=size-2 {panic("partial trim length");} }
    allocations=prototype_allocations();
    { let trimmed=blank.trim_ascii();row("trim_all",size,allocations,live,bytes);
      if !trimmed.is_empty() || prototype_allocations()!=allocations+1 {panic("all whitespace trim");} }
    allocations=prototype_allocations();
    { let invalid=text.try_slice(size,0);row("invalid_slice",size,allocations,live,bytes);
      if !invalid.is_err() || prototype_allocations()!=allocations+1 {panic("invalid slice allocation");} }
}
fn main()->i32 {
    exercise(129);exercise(1024);exercise(4096);exercise(65536);
    if prototype_live()!=2 || prototype_live_bytes()!=80 {panic("canonical empty accounting");}
    return 0;
}
