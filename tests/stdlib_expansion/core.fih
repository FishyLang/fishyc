fn text(raw:string)->String {return String.from_c_string(raw);}
fn text_size(value:String)->u64 {return value.len();}
fn optional_join(value:String)->Option<String> {return Option.Some(value.concat(text("c")));}
fn error_join(value:String)->String {return value.concat(text("!"));}
fn result_size(value:String)->Result<u64,String> {return Result.Ok(value.len());}
fn equal_text(a:&String,b:&String)->bool {return a.equals(b);}
fn main()->i32 {
    let none:Option<String>=Option.None();
    if !none.is_none() || !none.unwrap_or(text("fallback")).equals(text("fallback")) {return 1;}
    let some:Option<String>=Option.Some(text("ab"));
    let size=some.map(text_size);
    if size.unwrap()!=2 {return 2;}
    let some_again:Option<String>=Option.Some(text("ab"));let chained=some_again.and_then(optional_join);
    if !chained.unwrap().equals(text("abc")) {return 3;}
    let success:Result<String,String>=Result.Ok(text("ok"));
    if success.map(text_size).unwrap()!=2 {return 4;}
    let failure:Result<String,String>=Result.Err(text("error"));
    let mapped=failure.map_err(error_join);
    match mapped {Ok(value)->{return 5;}Err(error)->{if !error.equals(text("error!")) {return 5;}}};
    let none_map:Option<String>=Option.None();let none_then:Option<String>=Option.None();let failure_map:Result<String,String>=Result.Err(text("error"));let failure_then:Result<String,String>=Result.Err(text("error"));
    if none_map.map(text_size).is_some() || none_then.and_then(optional_join).is_some() || failure_map.map(text_size).is_ok() || failure_then.and_then(result_size).is_ok() {return 23;}
    let success_again:Result<String,String>=Result.Ok(text("ok"));let chain=success_again.and_then(result_size);
    if chain.unwrap()!=2 {return 6;}
    let mut vec:Vec<String>=Vec.new();vec.push(text("abc"));vec.push(text("def"));
    if vec.len()!=2 || vec.try_get(2).is_some() || !vec.first().unwrap().equals(text("abc")) || !vec.last().unwrap().equals(text("def")) {return 7;}
    if !vec.contains_by(text("def"),equal_text) {return 8;}
    let mut copied:Vec<String>=Vec.new();let mut ci:u64=0;while ci<vec.len(){copied.push(vec.get(ci).clone());ci=ci+1;}vec.clear();vec.drop();
    if copied.len()!=2 || !copied.get(0).equals(text("abc")) {return 9;}copied.drop();
    let mut list:List<String>=List.new();let mut i:u64=0;
    while i<257 {list=list.push(String.from_u64(i));i=i+1;}
    let changed=list.set(128,text("changed")).unwrap();
    if !list.get(128).unwrap().equals(text("128")) || !changed.get(128).unwrap().equals(text("changed")) || list.get(257).is_some() || list.set(257,text("x")).is_ok() {return 10;}
    let words=text("a,,b,").split(text(","));
    if words.len()!=4 || !words.get(1).unwrap().is_empty() || !words.last().unwrap().is_empty() {return 11;}
    if text("abc").split(text("")).len()!=1 {return 12;}
    let lines=text("one\r\n\ntwo\n").lines();
    if lines.len()!=3 || !lines.get(0).unwrap().equals(text("one")) || !lines.get(1).unwrap().is_empty() || text("").lines().len()!=0 {return 13;}
    if !text(" \tAbC\r\n").trim_start().equals(text("AbC\r\n")) || !text(" x \t").trim_end().equals(text(" x")) {return 14;}
    if !text("FishY").to_upper_ascii().equals(text("FISHY")) || !text("FishY").to_lower_ascii().equals(text("fishy")) {return 15;}
    if text("abab").find_from(text("ab"),1).unwrap()!=2 || text("a").find_from(text(""),2).is_some() || !text("").contains(text("")) {return 16;}
    if !text("ab").repeat(3).unwrap().equals(text("ababab")) || text("ab").repeat(18_446_744_073_709_551_615).is_ok() {return 17;}
    if !text("aaa").replace(text("aa"),text("b")).unwrap().equals(text("ba")) || text("a").replace(text(""),text("b")).is_ok() {return 18;}
    let mut bytes=ByteBuffer.new();bytes.push(65);bytes.push(0);bytes.push(255);let binary=bytes.snapshot();
    let mut joined=ByteBuffer.new();joined.append_string(binary);let raw=joined.snapshot().to_raw_bytes();
    if raw[1]!=0 || raw[2]!=255 {free(raw);return 19;}
    let imported=String.from_raw_bytes(raw,3).unwrap();free(raw);if !imported.equals(binary) {return 20;}
    bytes.clear();if !bytes.is_empty() || bytes.capacity()!=0 {return 21;}
    if !is_ascii_digit(57) || is_ascii_alpha(255) || !is_ascii_alphanumeric(65) {return 22;}
    println(text("core ok")).unwrap();return 0;
}
