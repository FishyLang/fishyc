extern fn prototype_allocations()->u64;
extern fn prototype_live()->u64;
extern fn prototype_live_bytes()->u64;
fn record(n:u64, op:string, a:u64, live:u64, bytes:u64)->void {
    printf("measure %lu %s %lu %lu %lu\n",n,op,prototype_allocations()-a,prototype_live()-live,prototype_live_bytes()-bytes);
}
fn workload(n:u64)->void {
    let initial=prototype_live();
    let raw=malloc(n+1); if raw==null { panic("profile OOM"); }
    let i:u64=0; while i<n { raw[i]=(97+i%26) as u8;i=i+1; } raw[n]=0;
    let a=prototype_allocations();let live=prototype_live();let bytes=prototype_live_bytes();
    {
        let text=String.from_c_string(raw);record(n,"construct",a,live,bytes);
        let ca=prototype_allocations();let cl=prototype_live();let cb=prototype_live_bytes();
        {let joined=text.concat(text);record(n,"concat",ca,cl,cb);if joined.len()!=2*n {panic("concat length");}}
        let ea=prototype_allocations();let el=prototype_live();let eb=prototype_live_bytes();
        {let out=text.to_c_string().unwrap();record(n,"export",ea,el,eb);if out[n]!=0 {panic("terminator");}free(out);}
        let builder=ByteBuffer.new();builder.append_c_string(raw);
        let sa=prototype_allocations();let sl=prototype_live();let sb=prototype_live_bytes();
        {let snap=String.from_bytes(builder);record(n,"snapshot",sa,sl,sb);
         let qa=prototype_allocations();let ql=prototype_live();let qb=prototype_live_bytes();
         if !text.equals(snap) {panic("equality");}record(n,"equals",qa,ql,qb);}
        let ba=prototype_allocations();let bl=prototype_live();let bb=prototype_live_bytes();
        {let copy=builder.copy();record(n,"copy",ba,bl,bb);if copy.len()!=n {panic("copy length");}}
    }
    free(raw);
    if prototype_live()!=initial {panic("profile cleanup");}
}
fn main()->i32 {
    let sizes:[u64;21]=[0,1,3,31,32,33,63,64,65,127,128,129,255,256,257,511,512,513,1024,4096,65536];
    let i:u64=0;while i<21 {workload(sizes[i]);i=i+1;}
    return 0;
}
