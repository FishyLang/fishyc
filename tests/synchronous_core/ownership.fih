struct Node<T> { pub value:T, pub next:Option<Node<T>>, }
// The test-only LLVM definition consumes and releases this owner on normal exit.
extern fn arc_probe(value:Node<String>, mode:i32)->i32;
fn identity<T>(value:T)->T { return value; }
fn main(argc:i32,argv:^^u8)->i32 {
    let async=20;let await=22;
    let text=String.from_c_string("owned");
    let none:Option<Node<String>>=Option.None();
    let leaf:Node<String>=Node{value:text.clone(),next:none};
    let root:Node<String>=Node{value:identity(text.clone()),next:Option.Some(leaf)};
    let left:Node<String>=Node{value:text.clone(),next:Option.None()};
    let right:Node<String>=Node{value:text.clone(),next:Option.None()};
    let graph=(root,[left,right]);
    let mut values:List<String>=List.new();
    values=values.push(graph.0.value.clone());values=values.push(text);
    let captured=fn()->String{return values.get(1).unwrap().clone();};
    let result:Result<String,string>=Result.Ok(captured());
    let raw=result.unwrap().to_c_string().unwrap();
    printf("%s %ld\n",raw,async+await);free(raw);
    let [returned_root,siblings]=graph;
    return arc_probe(returned_root,argc);
}
