struct Point3<T> {
    pub x: T,
    pub y: T,
    pub z: T,
}

impl<T> Point3<T> {
    pub fn add3(self) -> T {
        return self.x + self.y + self.z;
    }

    pub fn getX(self) -> T {
        return self.x;
    }

    pub fn getY(self) -> T {
        return self.y;
    }

    pub fn getZ(self) -> T {
        return self.z;
    }
}

fn main() -> i64 {
    let point3 = Point3<f32> { x: 2.2, y: 4.4, z: 6.6 };

    printf("%f\n", point3.add3());

    printf("%f\n", point3.getX());
    printf("%f\n", point3.getY());
    printf("%f\n", point3.getZ());

    printf("%f\n", 1.1 as f16);
    printf("%f\n", 1.1 as f32);
    printf("%f\n", 1.1 as f64);

    let a: i64 = 1;
    printf("%f\n", f16.min());

    let str1 = "John";
    printf("%d\n", str1.len());
    printf("%s\n", str1.is_empty().to_string());
    printf("%s\n", str1.contains("h").to_string());
    printf("%s\n", str1.starts_with("J").to_string());
    printf("%s\n", str1.ends_with("n").to_string());

    printf("%s\n", str1.equals(str1).to_string());

    let short_name = str1.substring(0, 3);
    printf("%s\n", short_name);
    free(short_name);

    let n1: u8 = 254;
    let n2: u8 = 1;

    printf("%d\n", n1 + n2);

    let doubled_name = str1.concat(str1);
    printf("%s\n", doubled_name);
    free(doubled_name);

    printf("write down your favorite fruits separated by a dash (-): \n");
    
    let stdin = read_line(128);
    let fruits = stdin.split("-");
    
    printf("\nyour fruits are:\n");
    let i = 0;

    while i < fruits.length() {
        // A nonempty delimiter produces independently owned token buffers.
        let fruit = fruits.get(i);
        printf("- %s\n", fruit);
        free(fruit);
        i = i + 1;
    }

    fruits.drop();
    free(stdin);

    return 0;
}