pub fn panic(message: ^u8) -> void {
    printf("\n--- FISHY RUNTIME PANIC ---\n");
    printf("FATAL: %s\n", message);
    printf("PROGRAM HAS BEEN TERMINATED TO AVOID MEMORY CORRUPTION\n");
    
    exit(1);
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> bool {
        return match self {
            Ok(v) -> true;
            Err(e) -> false;
        };
    }

    pub fn is_err(self) -> bool {
        return match self {
            Ok(v) -> false;
            Err(e) -> true;
        };
    }

    pub fn unwrap(self) -> T {
        return match self {
            Ok(v) -> v;
            
            Err(e) -> {
                panic("Called Result#unwrap on an Err value\n");

                // little bypass to stop the compiler from freaking out
                // temporary fix until we improve the typechecking
                // all this does is prevent the compiler from printing out (null),
                // aborts execution and returns a dummy T type (i'm mansplaining this,
                // but it's easy to understand)
                let dummy: T;
                return dummy;
            }
        };
    }

    pub fn unwrap_or(self, default_val: T) -> T {
        return match self {
            Ok(v) -> v;
            Err(e) -> default_val;
        };
    }
}

enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    pub fn is_some(self) -> bool {
        return match self {
            Some(v) -> true;
            None -> false;
        };
    }

    pub fn unwrap(self) -> T {
        return match self {
            Some(v) -> v;
            None -> {
                panic("Called Option#unwrap on a None value");

                // same sneaky bypass used in Result
                let dummy: T;
                return dummy;   
            }
        };
    }
}

struct Vec<T> {
    data: ^T,
    len: u64,
    capacity: u64,
}

impl<T> Vec<T> {
    pub fn new() -> Vec<T> {
        return Vec<T> { 
            data: 0 as ^T,
            len: 0,
            capacity: 0,
        };
    }

    // --- getters ----
    pub fn length(self) -> u64 {
        return self.len;
    }

    pub fn get_capacity(self) -> u64 {
        return self.capacity;
    }

    // --- memory management ---
    pub fn reserve(self, new_cap: u64) -> void {
        if new_cap <= self.capacity {
            return;
        }

        let size_in_bytes = new_cap * 8;

        if self.capacity == 0 {
            self.data = malloc(size_in_bytes) as ^T;
        } else {
            self.data = realloc(self.data as ^u8, size_in_bytes) as ^T;
        }

        if self.data == 0 as ^T {
            panic("out of memory during Vec#reserve");
        }

        self.capacity = new_cap;
    }

    pub fn drop(self) -> void {
        if self.capacity > 0 {
            free(self.data as ^u8);
            self.capacity = 0;
            self.len = 0;
        }
    }

    // --- accessing and mutating ---
    pub fn push(self, item: T) -> void {
        if self.len == self.capacity {
            let next_cap: u64 = 4;

            if self.capacity > 0 {
                next_cap = self.capacity * 2;
            }

            self.reserve(next_cap);
        }

        self.data[self.len] = item;
        self.len = self.len + 1;
    }

    pub fn insert(self, index: u64, item: T) -> void {
        if index > self.len {
            panic("index out of bounds in Vec#insert");
        }

        if self.len == self.capacity {
            let next_cap: u64 = 4;

            if self.capacity > 0 {
                next_cap = self.capacity * 2;
            }

            self.reserve(next_cap);
        }

        let i = self.len;
        while i > index {
            self.data[i] = self.data[i - 1];
            i = i - 1;
        }

        self.data[index] = item;
        self.len = self.len + 1;
    }

    pub fn pop(self) -> Result<T, string> {
        if self.len == 0 {
            return Result.Err("cannot pop from an empty Vec");
        }

        self.len = self.len - 1;
        return Result.Ok(self.data[self.len]);
    }

    pub fn remove(self, index: u64) -> T {
        if index >= self.len {
            panic("index out of bounds in Vec#remove");
        }

        let removed_item = self.data[index];
        let i = index;

        while i < (self.len - 1) {
            self.data[i] = self.data[i + 1];
            i = i + 1;
        }

        self.len = self.len - 1;
        return removed_item;
    }

    pub fn swap_remove(self, index: u64) -> T {
        if index >= self.len {
            panic("index out of bounds for Vec#swap_remove");
        }

        let removed_item = self.data[index];
        self.len = self.len - 1;

        if index < self.len {
            self.data[index] = self.data[self.len];
        }

        return removed_item;
    }

    pub fn clear(self) -> void {
        self.len = 0;
    }

    pub fn get(self, index: u64) -> T {
        if index >= self.len {
            panic("index out of bounds in Vec#get");
        }

        return self.data[index];
    }

    pub fn set(self, index: u64, value: T) -> void {
        if index >= self.len {
            panic("index out of bounds in Vec#set");
        }

        self.data[index] = value;
    }

    pub fn is_empty(self) -> bool {
        return self.len == 0;
    }

    pub fn into_array(self) -> ^T {
        let array_ptr = self.data;
        self.capacity = 0;
        self.len = 0;
        self.data = 0 as ^T;
        return array_ptr;
    }

    pub fn clone(self) -> Vec<T> {
        let new_vec = Vec<T> {
            data: 0 as ^T,
            len: 0,
            capacity: 0,
        };

        new_vec.reserve(self.capacity);
        new_vec.len = self.len;
        
        if self.len > 0 {
            let bytes_to_copy = self.len * 8; 
            memcpy(new_vec.data as ^u8, self.data as ^u8, bytes_to_copy);
        }
        
        return new_vec;
    }
}

pub fn read_line(buf_size: u64) -> string {
    let buffer = malloc(buf_size);
    let i: u64 = 0;
    let reading = true;

    while reading {
        let c = getchar();

        if c == -1 {
            reading = false;
        } else if c == 10 {
            reading = false;
        } else {
            if i < (buf_size - 1) {
                buffer[i] = c as u8;
                i = i + 1;
            }
        }
    }

    buffer[i] = 0 as u8;

    let final_str = malloc(i + 1);
    let j: u64 = 0;
    while j < i {
        final_str[j] = buffer[j];
        j = j + 1;
    }

    final_str[i] = 0;
    free(buffer);

    return final_str;
}

impl u8 {
    pub fn min() -> u8 {
        return 0;
    }

    pub fn max() -> u8 {
        return 255;
    }

    pub fn clamp(self, min: u8, max: u8) -> u8 {
        if self < min { return min; }
        if self > max { return max; }

        return self;
    }
}

