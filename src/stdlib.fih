impl f32 {}

impl f64 {}

impl bool {}

impl string {
    pub fn len(self) -> u64 {
        return strlen(self);
    }

    pub fn is_empty(self) -> bool {
        return self.len() == 0;
    }

    pub fn contains(self, sub: string) -> bool {
        if sub.len() == 0 {
            return 0;
        }

        return strstr(self, sub) != 0;
    }

    pub fn starts_with(self, prefix: string) -> bool {
        let p_len = prefix.len();

        if self.len() < p_len {
            return false;
        }

        let i = 0;
        while i < p_len {
            if self[i] != prefix[i] {
                return false;
            }

            i = i + 1;
        }

        return true;
    }

    pub fn ends_with(self, suffix: string) -> bool {
        let s_len = self.len();
        let sub_len = suffix.len();

        if sub_len > s_len {
            return false;
        }

        let offset = s_len - sub_len;
        let i = 0;

        while i < sub_len {
            if self[offset + i] != suffix[i] {
                return false;
            }

            i = i + 1;
        }

        return true;
    }

    pub fn equals(self, other: string) -> bool {
        return strcmp(self, other) == 0;
    }

    pub fn substring(self, start: u64, end: u64) -> string {
        let s_len = self.len();
        let safe_end = end;

        if safe_end > s_len {
            safe_end = s_len;
        }

        if start >= safe_end {
            let empty = malloc(1);
            empty[0] = 0 as u8;
            return empty;
        }

        let len = safe_end - start;
        let dest = malloc(len + 1);
        let src_offset = ((self as u64) + start) as string;

        strncpy(dest, src_offset, len);

        dest[len] = 0 as u8;

        return dest;
    }

    pub fn split(self, delim: string) -> Vec<string> {
        let result = Vec<string> {
            data: malloc(128) as ^string,
            len: 0,
            capacity: 10
        };

        let s_len = self.len();
        let d_len = delim.len();

        if d_len == 0 {
            result.push(self);
            return result;
        }

        let start = 0;
        let i: u64 = 0;

        while i + d_len <= s_len {
            let match_found = true;
            let j: u64 = 0;

            while j < d_len {
                if self[i + j] != delim[j] {
                    match_found = false;
                }

                j = j + 1;
            }

            if match_found {
                result.push(self.substring(start, i));
                i = i + d_len;
                start = i;
            } else {
                i = i + 1;
            }
        }

        result.push(self.substring(start, s_len));
        
        return result;
    }

    pub fn concat(self, other: string) -> string {
        let len1 = self.len();
        let len2 = other.len();

        let new_str = malloc(len1 + len2 + 1) as string;

        strncpy(new_str, self, len1);

        let offset_ptr = ((new_str as u64) + len1) as string;
        strncpy(offset_ptr, other, len2);

        new_str[len1 + len2] = 0 as u8;
        return new_str;
    }
}
