// Fishy canonical monolithic standard library. Raw compatibility APIs are retained.
// =====================================================
// Native declarations / low-level compatibility
// =====================================================
extern fn pow(f64, f64) -> f64;
extern fn malloc(u64) -> ^u8;
extern fn free(^u8) -> void;
extern fn realloc(^u8, u64) -> ^u8;
extern fn memcpy(^u8, ^u8, u64) -> ^u8;
extern fn memset(^u8, i32, u64) -> ^u8;
extern fn printf(^u8, ...) -> i32;
extern fn snprintf(^u8, u64, ^u8, ...) -> i32;

extern fn fopen(^u8, ^u8) -> ^u8;
extern fn fclose(^u8) -> i32;
extern fn fputs(^u8, ^u8) -> i32;
extern fn fprintf(^u8, ^u8, ...) -> i32;

extern fn exit(i32) -> void;
extern fn getchar() -> i32;

extern fn strlen(^u8) -> u64;
extern fn strcat(^u8, ^u8) -> ^u8;
extern fn strstr(^u8, ^u8) -> ^u8;
extern fn strcmp(^u8, ^u8) -> i32;
extern fn strncpy(^u8, ^u8, u64) -> ^u8;

pub fn panic(message: ^u8) -> void {
    printf("\n--- FISHY RUNTIME PANIC ---\n");
    printf("FATAL: %s\n", message);
    printf("PROGRAM HAS BEEN TERMINATED TO AVOID MEMORY CORRUPTION\n");

    exit(1);
}

// Private immutable backing. Owning Shared values move; only this explicit
// clone operation creates another logical handle to the frozen payload.
struct Shared<T> { value:T, }
impl<T> Shared<T> {
    pub fn new(value:T)->Shared<T> {return Shared<T>{value:value};}
    pub fn get(self)->&T {return &self.value;}
    pub fn clone(self)->Shared<T> {return __fishy_shared_clone(self);}
}

// Replace initialized storage without exposing a partially moved aggregate.
fn replace_value<T>(place:&mut T,value:T)->T {return __fishy_replace_value(place,value);}

// =====================================================
// Option / Result
// =====================================================
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    pub fn map<U>(self: Result<T, E>, mut transform:fn(T)->U)->Result<U,E> {
        return match self { Ok(value)->Result.Ok(transform(value)); Err(error)->Result.Err(error); };
    }
    pub fn map_err<F>(self: Result<T, E>, mut transform:fn(E)->F)->Result<T,F> {
        return match self { Ok(value)->Result.Ok(value); Err(error)->Result.Err(transform(error)); };
    }
    pub fn and_then<U>(self: Result<T, E>, mut transform:fn(T)->Result<U,E>)->Result<U,E> {
        return match self { Ok(value)->transform(value); Err(error)->Result.Err(error); };
    }

    pub fn is_ok(self) -> bool {
        return match self {
            Ok(v) -> true;
            Err(e) -> false;
        };
    }

    pub fn is_err(self) -> bool {
        return match self {
            Ok(v) -> false;
            Err(e) -> true;
        };
    }

    pub fn unwrap(self: Result<T, E>) -> T {
        return match self {
            Ok(v) -> v;

            Err(e) -> {
                panic("Called Result#unwrap on an Err value\n");

            }
        };
    }

    pub fn unwrap_or(self: Result<T, E>, default_val: T) -> T {
        return match self {
            Ok(v) -> v;
            Err(e) -> default_val;
        };
    }
}

pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    pub fn is_none(self)->bool {return !self.is_some();}
    pub fn unwrap_or(self: Option<T>, fallback:T)->T {
        return match self { Some(value)->value; None->fallback; };
    }
    pub fn map<U>(self: Option<T>, mut transform:fn(T)->U)->Option<U> {
        return match self { Some(value)->Option.Some(transform(value)); None->Option.None(); };
    }
    pub fn and_then<U>(self: Option<T>, mut transform:fn(T)->Option<U>)->Option<U> {
        return match self { Some(value)->transform(value); None->Option.None(); };
    }

    pub fn is_some(self) -> bool {
        return match self {
            Some(v) -> true;
            None -> false;
        };
    }

    pub fn unwrap(self: Option<T>) -> T {
        return match self {
            Some(v) -> v;
            None -> {
                panic("Called Option#unwrap on a None value");

            }
        };
    }
}

// =====================================================
// Collections (Vec owns initialized cells and its raw backing allocation)
// =====================================================
pub struct Vec<T> {
    data: ^T,
    count: u64,
    capacity: u64,
}

impl<T> Vec<T> {
    pub fn len(self)->u64 {return self.count;}
    pub fn length(self)->u64 {return self.count;}
    pub fn get_capacity(self)->u64 {return self.capacity;}
    pub fn is_empty(self)->bool {return self.count==0;}
    pub fn new()->Vec<T> {return Vec<T>{data:0 as ^T,count:0,capacity:0};}
    pub fn reserve(self:&mut Vec<T>,new_cap:u64)->void {
        if new_cap<=self.capacity {return;}
        let element_size:u64=__fishy_storage_size;
        if new_cap>18_446_744_073_709_551_615/element_size {panic("Vec capacity overflow");}
        let bytes=new_cap*element_size;
        if self.capacity==0 {self.data=malloc(bytes) as ^T;}
        else {self.data=realloc(self.data as ^u8,bytes) as ^T;}
        if self.data==0 as ^T {panic("out of memory during Vec#reserve");}
        self.capacity=new_cap;
    }
    fn grow(self:&mut Vec<T>)->void {
        if self.count<self.capacity {return;}
        if self.capacity>9_223_372_036_854_775_807 {panic("Vec capacity overflow");}
        let mut next:u64=4;if self.capacity>0 {next=self.capacity*2;}
        self.reserve(next);
    }
    pub fn push(self:&mut Vec<T>,item:T)->void {
        self.grow();__fishy_raw_initialize(self,self.data,self.count,item);self.count=self.count+1;
    }
    pub fn insert(self:&mut Vec<T>,index:u64,item:T)->void {
        if index>self.count {panic("index out of bounds in Vec#insert");}
        self.grow();let mut i=self.count;
        while i>index {
            let moved=__fishy_raw_take(self,self.data,i-1);
            __fishy_raw_initialize(self,self.data,i,moved);i=i-1;
        }
        __fishy_raw_initialize(self,self.data,index,item);self.count=self.count+1;
    }
    pub fn pop(self:&mut Vec<T>)->Result<T,string> {
        if self.count==0 {return Result.Err("cannot pop from an empty Vec");}
        self.count=self.count-1;
        let value=__fishy_raw_take(self,self.data,self.count);return Result.Ok(value);
    }
    pub fn remove(self:&mut Vec<T>,index:u64)->T {
        if index>=self.count {panic("index out of bounds in Vec#remove");}
        let removed=__fishy_raw_take(self,self.data,index);let mut i=index;
        while i+1<self.count {
            let moved=__fishy_raw_take(self,self.data,i+1);
            __fishy_raw_initialize(self,self.data,i,moved);i=i+1;
        }
        self.count=self.count-1;return removed;
    }
    pub fn swap_remove(self:&mut Vec<T>,index:u64)->T {
        if index>=self.count {panic("index out of bounds for Vec#swap_remove");}
        let removed=__fishy_raw_take(self,self.data,index);self.count=self.count-1;
        if index<self.count {
            let moved=__fishy_raw_take(self,self.data,self.count);
            __fishy_raw_initialize(self,self.data,index,moved);
        }
        return removed;
    }
    pub fn clear(self:&mut Vec<T>)->void {
        while self.count>0 {self.count=self.count-1;__fishy_raw_drop(self,self.data,self.count);}
    }
    // Compatibility method; scope cleanup also owns the backing allocation.
    pub fn drop(self:&mut Vec<T>)->void {
        self.clear();free(self.data as ^u8);self.data=0 as ^T;self.capacity=0;
    }
    pub fn get(self,index:u64)->&T {
        if index>=self.count {panic("index out of bounds in Vec#get");}
        return __fishy_raw_borrow(self,self.data,index);
    }
    pub fn try_get(self,index:u64)->Option<&T> {
        if index>=self.count {return Option.None();}return Option.Some(self.get(index));
    }
    pub fn first(self)->Option<&T> {return self.try_get(0);}
    pub fn last(self)->Option<&T> {if self.count==0 {return Option.None();}return self.try_get(self.count-1);}
    pub fn set(self:&mut Vec<T>,index:u64,value:T)->void {
        if index>=self.count {panic("index out of bounds in Vec#set");}
        __fishy_raw_drop(self,self.data,index);__fishy_raw_initialize(self,self.data,index,value);
    }
    pub fn contains_by(self,value:&T,mut equal:fn(&T,&T)->bool)->bool {
        let mut i:u64=0;while i<self.count {if equal(self.get(i),value) {return true;}i=i+1;}return false;
    }
    // Explicit legacy raw-parts export transfers manual cleanup to the caller.
    pub fn into_array(self:&mut Vec<T>)->^T {
        let raw=self.data;self.data=0 as ^T;self.count=0;self.capacity=0;return raw;
    }
}

pub fn read_line(buf_size: u64) -> string {
    if buf_size == 0 {panic("read_line buffer size must be positive");}
    let mut buffer = malloc(buf_size);
    if buffer == null {panic("Out of memory in read_line");}
    let mut i: u64 = 0;
    let mut reading = true;

    while reading {
        let mut c = getchar();

        if c == -1 {
            reading = false;
        } else if c == 10 {
            reading = false;
        } else {
            if i < (buf_size - 1) {
                buffer[i] = c as u8;
                i = i + 1;
            }
        }
    }

    buffer[i] = 0 as u8;

    let mut final_str = malloc(i + 1);
    if final_str == null {panic("Out of memory in read_line");}
    let mut j: u64 = 0;
    while j < i {
        final_str[j] = buffer[j];
        j = j + 1;
    }

    final_str[i] = 0;
    free(buffer);

    return final_str;
}

